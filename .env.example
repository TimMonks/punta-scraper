# Home Assistant MQTT Broker
HA_MQTT_HOST=192.168.1.x
HA_MQTT_PORT=1883
HA_MQTT_USERNAME=
HA_MQTT_PASSWORD=

# Flask session-signing key. Leave empty: the app generates one on first start
# and keeps it in data/config.json, so sessions survive restarts. To pin it, set
# a long random value (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=

# Authentik OIDC (the web UI's only login outside HA ingress)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URI=
OIDC_END_SESSION_URL=
OIDC_ADMIN_GROUP=authentik Admins

# Timezone
TZ=Europe/Paris

# Log output: json (default; one JSON object per line for Loki) or text
LOG_FORMAT=json
